#!/usr/bin/env bun
// Talk to Millennium's external protocol from the shell.
//
// MEP is a unix socket any local process can speak: 4-byte little-endian length
// prefix, msgpack body, one response per request. It is how the click bridge
// reaches into the running plugin, and it is useful on its own for poking at a
// live Steam without a devtools session.
//
// Usage:
//   mep <method> [key=value ...]        params are strings unless they parse as JSON
//   mep --methods                       the ones this tool knows are useful
//
// Examples:
//   mep millennium.version
//   mep plugin.config.set name=me.tysmith.steam-native-notifications key=selftest value=go
//   mep plugin.config.get_all name=me.tysmith.steam-native-notifications
//
// The socket is /tmp/millennium-mep.sock on POSIX and %TEMP%\millennium-mep.sock
// on Windows (tools/lib/snn.ts); bun opens both. Runs on every platform
// (on Windows: bun tools/mep ...).
import { USEFUL_MEP_METHODS, parseMepParam } from './lib/devtools';
import { decode, encode, frame, takeFrame } from './lib/msgpack';
import { mepSocketPath, usageFromHeader } from './lib/snn';

function fail(message: string): never {
	console.error(message);
	process.exit(1);
}

function call(method: string, params: Record<string, unknown>, timeoutMs = 5000): Promise<Record<string, unknown>> {
	// No existence check up front: on Windows the socket is a reparse point
	// that stat cannot see, so the connect itself is the test.
	const socket = mepSocketPath();
	const request: Record<string, unknown> = { id: 'mep-cli', method };
	if (Object.keys(params).length) request.params = params;
	const out = frame(encode(request as never));

	// Bun sockets do not buffer: a write may take fewer bytes than offered,
	// and the rest goes out from the drain callback.
	let sent = 0;
	const pump = (s: { write(data: Uint8Array): number }) => {
		while (sent < out.length) {
			const n = s.write(out.subarray(sent));
			if (n <= 0) return;
			sent += n;
		}
	};

	// The reply arrives in chunks; they are joined once, when the length
	// prefix says the whole frame is in.
	const chunks: Uint8Array[] = [];
	let total = 0;
	let expected = -1;
	const complete = () => expected >= 0 && total >= 4 + expected;

	return new Promise<Record<string, unknown>>((resolve, reject) => {
		const timer = setTimeout(() => reject(new Error(`no complete reply within ${timeoutMs / 1000} s`)), timeoutMs);
		const finish = (fn: () => void) => {
			clearTimeout(timer);
			fn();
		};
		Bun.connect({
			unix: socket,
			socket: {
				open(s) {
					pump(s);
				},
				drain(s) {
					pump(s);
				},
				data(s, chunk) {
					chunks.push(chunk);
					total += chunk.length;
					if (expected < 0 && total >= 4) expected = Buffer.concat(chunks, 4).readUInt32LE(0);
					if (!complete()) return;
					s.end();
					const got = takeFrame(Buffer.concat(chunks));
					if (!got) return finish(() => reject(new Error('reply frame did not take')));
					if (got.rest.length) return finish(() => reject(new Error(`${got.rest.length} byte(s) after the reply frame -- more than one response`)));
					finish(() => {
						try {
							const reply = decode(got.body);
							if (!reply || typeof reply !== 'object' || Array.isArray(reply)) throw new Error('reply is not a map');
							resolve(reply as Record<string, unknown>);
						} catch (e) {
							reject(e);
						}
					});
				},
				close() {
					if (!complete()) finish(() => reject(new Error('connection closed before a complete reply')));
				},
				error(_s, e) {
					finish(() => reject(e));
				},
				connectError(_s, e) {
					const code = (e as NodeJS.ErrnoException).code;
					finish(() => reject(new Error(code === 'ENOENT'
						? `${socket} is not there -- is Steam running with Millennium?`
						: `${socket} refused the connection -- Millennium may be starting up. (${e.message})`)));
				},
			},
		}).catch((e: Error) => finish(() => reject(e)));
	});
}

const argv = process.argv.slice(2);
if (argv.length === 0 || argv[0] === '-h' || argv[0] === '--help') {
	console.log(usageFromHeader(import.meta.path));
	process.exit(0);
}
if (argv[0] === '--methods') {
	console.log(USEFUL_MEP_METHODS.map((m) => `  ${m}`).join('\n'));
	process.exit(0);
}
const params: Record<string, unknown> = {};
for (const token of argv.slice(1)) {
	try {
		const [k, v] = parseMepParam(token);
		params[k] = v;
	} catch (e) {
		fail((e as Error).message);
	}
}
let reply: Record<string, unknown>;
try {
	reply = await call(argv[0], params);
} catch (e) {
	fail((e as Error).message);
}
console.log(JSON.stringify(reply, (_k, v) => (typeof v === 'bigint' ? Number(v) : v), 2));
process.exit(reply.error ? 1 : 0);
